;; Unit tests for web/req-log's structured record builders (start-record/done-record/
;; error-record) — the shape each lifecycle event is logged as. Formatting that shape into
;; text/JSON lines used to be tested here too, against a demo-local main/text-line and
;; main/json-line — but those were deleted when main.blsp was refactored onto
;; web/application/start (the formatting logic moved into the framework as
;; web/application's private application--text-line/application--json-line, now covered
;; by hatch's own web_application_test.blsp). This file only owns the record shape,
;; which is still demo-side code.
(defmodule web-req-log-test
  (:use web/req-log :only [start-record done-record error-record])
  (:use test))

(describe "web/req-log — record shapes"
  (test "start-record is :debug, tagged request.start"
    (let (r (start-record "r1" "GET" "/"))
      (is (= (get r :level) :debug))
      (is (= (get r :msg) "[r1] GET /"))
      (is (= (get (get r :meta) :event) "request.start"))
      (is (= (get (get r :meta) :request_id) "r1"))))
  (test "done-record is :debug and request.complete when not slow"
    (let (r (done-record "r1" "GET" "/" 200 4.2 false))
      (is (= (get r :level) :debug))
      (is (= (get r :msg) "[r1] GET / 200 4.2ms"))
      (is (= (get (get r :meta) :status_code) 200))
      (is (= (get (get r :meta) :duration_ms) 4.2))
      (is (= (get (get r :meta) :event) "request.complete"))))
  (test "a slow request's completion is :warn and tagged request.slow"
    (let (r (done-record "r2" "GET" "/slow" 200 2004.2 true))
      (is (= (get r :level) :warn))
      (is (= (get (get r :meta) :event) "request.slow"))))
  (test "a failed request is :error and carries the error message"
    (let (r (error-record "r3" "POST" "/pay" 500 3.1 "unbound symbol: inspect"))
      (is (= (get r :level) :error))
      (is (= (get (get r :meta) :event) "request.error"))
      (is (= (get (get r :meta) :error) "unbound symbol: inspect")))))

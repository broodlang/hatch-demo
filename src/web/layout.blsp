; stylesheet — the <link rel=stylesheet> helper
(defmodule web/layout
  "The shared HTML document shell: a daisyUI navbar plus the page body. Views call
  `(layout title & children)` and wrap the result with `html`. Styling comes from
  Tailwind + daisyUI, built into static/app.css by the asset watcher (see web/endpoint
  and bin/setup); this module links it by logical name via `static/asset-path`, so prod
  serves the fingerprinted, cache-forever URL and dev the plain one. It carries no
  live-view wiring: the
  router's `(live …)` clause injects the live-view client + status chrome into live
  pages, so plain pages (like the home page) stay plain."
  (:use web/template)
  ; asset-path — link app.css by logical name; prod resolves it to the fingerprinted,
  ; cache-forever URL, dev to the plain (revalidated) path
  (:alias web/static)
  ; get-flash — flash-banner reads both the "info" and "error" one-shot keys
  (:alias web/session))

(defn flash-banner (conn)
  "A one-shot `info`/`error` banner from the session flash, as a daisyUI alert, or nothing
  when there's no flash. `error` (a failed web/form validation, typically) wins if both are
  set — shared by every plain-page view with a flash-driven form (account, messages)
  instead of each hand-rolling the same info/error/none cond."
  (let (info (session/get-flash conn "info")
        err (session/get-flash conn "error"))
    (cond
      err [:div {:class "alert alert-error mb-4"} [:span {} err]]
      info [:div {:class "alert alert-success mb-4"} [:span {} info]]
      else "")))
(defn nav-link (href label)
  "A live-navigable link (`data-nav`): from a live page, clicking another live view swaps
  it over the open socket (no reload); a non-live target falls back to a normal load."
  [:a {:href href :data-nav true} label])

(defn nav-dropdown (label & items)
  "A daisyUI dropdown grouping related nav links under `label`."
  [:div
    {:class "dropdown dropdown-end"}
    [:div {:tabindex "0" :role "button" :class "btn btn-ghost btn-sm"} label]
    [:ul
      {:tabindex "0"
       :class "menu dropdown-content bg-base-200 rounded-box z-[1] w-56 p-2 shadow"}
      items]])

(defn nav-bar ()
  "The top menu bar — a daisyUI navbar. The live views are grouped by their live-session
  (`customer` / `admin`): clicking between two views in the same session swaps over the
  socket (no reload); crossing sessions forces a full reload (the auth boundary)."
  [:div
    {:class "navbar bg-base-300 shadow-sm sticky top-0 z-50"}
    [:div
      {:class "navbar-start"}
      [:a {:href "/" :data-nav true :class "btn btn-ghost text-xl"} "Hatch"]]
    [:div
      {:class "navbar-end gap-1"}
      (nav-dropdown "Customer"
        [:li {} (nav-link "/counter" "Counter")]
        [:li {} (nav-link "/counter-inline" "Counter (inline)")]
        [:li {} (nav-link "/signup" "Live form")]
        [:li {} (nav-link "/room" "Live room")]
        [:li {} (nav-link "/presence" "Live presence")]
        [:li {} (nav-link "/reorder" "Keyed list")]
        [:li {} (nav-link "/dashboard" "Dashboard (guarded)")])
      (nav-dropdown "Admin"
        [:li {} (nav-link "/admin/counter" "Counter")]
        [:li {} (nav-link "/admin/counter-inline" "Counter (inline)")])
      (nav-dropdown "Pages"
        [:li {} (nav-link "/page-inline" "Page (inline)")]
        [:li {} (nav-link "/page-template" "Page (template)")])
      [:a {:href "/messages" :data-nav true :class "btn btn-ghost btn-sm"} "Messages"]
      [:a {:href "/uploads" :data-nav true :class "btn btn-ghost btn-sm"} "Uploads"]
      [:a {:href "/account" :data-nav true :class "btn btn-ghost btn-sm"} "Account"]
      [:a {:href "/slow" :data-nav true :class "btn btn-ghost btn-sm"} "Slow"]
      [:a {:href "/dev" :data-nav true :class "btn btn-ghost btn-sm"} "Dev"]]])

; The navbar is identical on every page, so render it to HTML once at load and inject the
; cached string with `raw` — the bulk of a page's render time was re-walking this static
; tree per request. Reloading this module (dev hot-reload) recomputes it.
(def *nav-html* (render (nav-bar)))

;; A hatching egg, two ways from one source. The `<link rel=icon>` in the head takes the
;; data URL — no second request, and nothing to forget at deploy time — while
;; `web/views/home/favicon` serves the same markup at /favicon.ico for the clients that ask
;; without reading the page.
(def *favicon-svg*
  (str "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\">"
    "<text y=\"26\" font-size=\"26\">🥚</text>" "</svg>"))

(def *favicon*
  ;; Percent-encoded rather than base64: a data URL only has to escape the handful of
  ;; characters that would end the attribute or the URL, and the result stays readable.
  (str "data:image/svg+xml,"
    (-> *favicon-svg*
      (string/replace "\"" "'")
      (string/replace "<" "%3C")
      (string/replace ">" "%3E")
      (string/replace "#" "%23"))))

(defn layout (title & children)
  "The shared page shell: daisyUI navbar on top, page content in a centered <main>. The
  navbar is the pre-rendered `*nav-html*` (it never varies); only `title` and `children`
  are rendered per request."
  [:html
    {:data-theme "light"}
    [:head
      {}
      [:meta {:charset "utf-8"}]
      [:meta {:name "viewport" :content "width=device-width, initial-scale=1"}]
      ;; Both of these are here because hatch's own dev audit (web/audit) asked for them,
      ;; and a demo that ignores the framework's warnings is not much of a demo.
      ;;
      ;; `color-scheme` goes BEFORE the stylesheet: the sheet is render-blocking, and until
      ;; it arrives the browser paints its own default background — a flash on every
      ;; navigation. Declaring the scheme up front lets it paint the right ground first.
      [:meta {:name "color-scheme" :content "light dark"}]
      [:title {} title]
      ;; An inline SVG data URL rather than a served file: no second request, and nothing to
      ;; forget to deploy. Browsers that ask for /favicon.ico regardless get the same egg
      ;; from the route in web/routes.
      [:link {:rel "icon" :href *favicon*}]
      (stylesheet (static/asset-path "app.css"))]
    [:body
      {:class "min-h-screen bg-base-100 text-base-content"}
      (raw *nav-html*)
      [:main {:class "max-w-3xl mx-auto p-6"} children]]])

;; The error page. hatch's `web/errors` owns the pipeline — which responses to skin, which to
;; leave alone (a JSON body, a page a handler rendered itself), and the wording per status —
;; and calls this to put the page in the app's own shell. `web/server` wires it as the
;; endpoint's `:errors` `:render`.
(defn error-page (code title blurb)
  "An error page in the shared layout, so a 404 or a 500 looks like the rest of the app.
  Given the resolved `title` and `blurb`, so this carries no copy of the status table."
  (html (layout (str code " — " title)
          [:div
            {:class "text-center py-16"}
            [:h1 {:class "text-7xl font-bold text-primary"} (str code)]
            [:p {:class "text-2xl mt-4 mb-2"} title]
            [:p {:class "opacity-70 mb-8"} blurb]
            [:a {:href "/" :class "btn btn-primary"} "Back home"]])))

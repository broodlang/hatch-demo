(defmodule web/views/dashboard
  "A live view gated by `web/live`'s `on-mount-guard`: it only mounts once the demo's
  session (set on `/account`) remembers a non-blank name, redirecting to `/account`
  otherwise — both on the initial connect and on every live-navigate into this view.
  Proves the guard end to end against the demo's real session cookie, not just a unit
  test. The router wires it with `(live \"/dashboard\" …)` in the \"customer\"
  live-session group.

  Also embeds *two* independent web/views/components/like-button instances (a
  web/component LiveComponent) to prove that path end to end: each button's own click
  toggles only its own scoped state (proving components with different ids don't share
  state), and — to prove send-update's out-of-band path, not just a component's own
  events — clicking \"Click me\" a third time pushes a like into just the first button
  from the *parent's* event handler, outside either component's own on-click at all. A
  third component, counter-widget, is a LiveComponent whose markup comes from a `.bml`
  template rather than inline Hiccup."
  (:use web/live)
  ; get-session / fetch-session — the guard decodes the session cookie itself
  (:alias web/session)
  ; send-update — pushes state into the like-button component from the "bump" handler
  (:alias web/component)
  (:implements LiveModule))

; Mirrors web/routes' session-secret one-liner. Not imported from there: web/routes
; already requires this module to wire the route, so importing back would be a cycle.
(def session-secret
  (or (getenv "HATCH_SECRET_KEY_BASE") "dev-only-insecure-secret-change-me"))

(deflive (on-mount-guard (conn)
           (let (conn ((session/fetch-session session-secret) conn))
             (if (string/blank? (session/get-session conn "name" ""))
               "/account"
               nil)))

  (mount (params) {:count 0})

  (render (model)
    [:div
      {:class "space-y-4"}
      [:h1 {:class "text-2xl font-bold mb-2"} "Dashboard"]
      [:p
        {:class "opacity-70"}
        "You only reached this page because on-mount-guard let you in — it checked "
        "your session for a saved name (set on "
        [:a {:href "/account" :class "link"} "/account"]
        ") and would have redirected you there otherwise, on connect or on "
        "live-navigate."]
      [:div
        {:class "card bg-base-200"}
        [:div
          {:class "card-body"}
          [:p {:class "mb-2"} (str "Clicks: " (get model :count))]
          [:button {:data-event "bump" :class "btn btn-primary"} "Click me"]]]
      [:div
        {:class "card bg-base-200"}
        [:div
          {:class "card-body"}
          [:p
            {:class "mb-2 text-sm opacity-70"}
            "Two independent LiveComponents (web/component), each with its own scoped "
            "state — click either directly, or click \"Click me\" above three times to "
            "see the parent push a like into just the first one via send-update, from "
            "outside either component's own handler. The second never reacts to that "
            "push, and clicking one never toggles the other — different ids, separate "
            "state."]
          [:div
            {:class "flex gap-2"}
            (component web/views/components/like-button {"id" "dash-like"})
            (component web/views/components/like-button {"id" "dash-like-2"})]]]
      [:div
        {:class "card bg-base-200"}
        [:div
          {:class "card-body"}
          [:p
            {:class "mb-2 text-sm opacity-70"}
            "A third LiveComponent, rendered from a sibling "
            [:code {:class "badge badge-ghost"} "counter_widget.bml"]
            " template rather than inline Hiccup."]
          (component web/views/components/counter-widget {"id" "dash-counter" "start" 0})]]])

  (on "bump"
    (params model)
    (let (n (inc (get model :count)))
      ; demonstrate send-update: an out-of-band push into a component's state, from a
      ; handler that isn't the component's own — (self) is the session pid here, since
      ; handle-event runs in the session process.
      (when (= n 3) (component/send-update (self) "dash-like" {:liked? true}))
      (assoc model :count n))))

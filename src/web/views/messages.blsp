(defmodule web/views/messages
  "GET /messages — list all messages and a form to post a new one.
  GET /messages/:id — a single message, by id (the demo's one named-path-param route —
  every other route uses no params, a live-patch query param, or `*splat` for statics).
  POST /messages — insert the submitted message and redirect (PRG pattern).
  Wired through the session + CSRF pipeline in web/routes.
  `web/layout/flash-banner` renders the one-shot flash (shared with web/views/account,
  the other flash-driven form)."
  (:use web/page)
  (:use web/layout)
  (:use web/conn)
  ; raw — the fetch-post-script's inline <script> body, unescaped
  (:use web/template)
  (:alias web/session)
  (:alias web/csrf)
  ; validate / error-for — create's required-fields check
  (:alias web/form)
  (:alias db))

(defn index (conn)
  "GET /messages — render the message board: existing messages + a new-message form."
  (let (msgs (db/all-messages))
    (page conn
      (layout "Messages"
        [:h1 {:class "text-2xl font-bold mb-4"} "Message board · Postgres-backed"]
        [:p
          {:class "mb-4 opacity-70"}
          "Messages are persisted to PostgreSQL via "
          [:code {:class "badge badge-ghost"} "store-postgres"]
          ". POST → INSERT → redirect — the standard PRG pattern."]
        (flash-banner conn)
        (message-list msgs)
        (new-message-form conn)))))

(defn message-list (msgs)
  "Render the list of message cards, or an empty-state prompt. Each card's name links to
  `/messages/:id` — the named-path-param demo."
  (if (empty? msgs)
    [:p {:class "opacity-60 mb-6"} "No messages yet — be the first!"]
    [:div
      {:class "space-y-3 mb-6"}
      (map msgs
        (fn (m)
          [:div
            {:class "card bg-base-200"}
            [:div
              {:class "card-body py-3"}
              [:a
                {:href (str "/messages/" (get m :id)) :data-nav true :class "font-semibold link"}
                (get m :name)]
              [:p {} (get m :body)]]]))]))

(defn show (conn)
  "GET /messages/:id — a single message, or a not-found note. The `:id` path segment
  arrives in `(get conn :params)` as a string; the schema's `:id` column is an integer, so
  it's parsed before querying."
  (let (id (string/->number (or (param conn "id") "0"))
        msg (db/get-message id))
    (page conn
      (layout "Message"
        (if (nil? msg)
          [:p {} (str "No message with id " id ".")]
          [:div
            {:class "card bg-base-200"}
            [:div
              {:class "card-body"}
              [:p {:class "font-semibold"} (get msg :name)]
              [:p {} (get msg :body)]]])
        [:p {:class "mt-4"} [:a {:href "/messages" :data-nav true :class "link"} "← All messages"]]))))

(defn new-message-form (conn)
  "The form to post a new message. Two submit buttons hit the same POST /messages, proving
  both ways web/csrf accepts a token: a normal submit sends the hidden `_csrf_token` field;
  \"Post via fetch\" instead sends it as the `X-CSRF-Token` header (protect-from-forgery's
  fetch/JSON-client path — `web/csrf/submitted-token` accepts either)."
  [:form
    {:id "message-form" :method "post" :action "/messages" :class "card bg-base-200"}
    [:div
      {:class "card-body space-y-3"}
      [:h2 {:class "card-title"} "Post a message"]
      (web/csrf/csrf-input conn)
      [:label {:class "label"} [:span {:class "label-text"} "Name"]]
      [:input {:name "name" :placeholder "Your name" :class "input input-bordered w-full"}]
      [:label {:class "label"} [:span {:class "label-text"} "Message"]]
      [:textarea
        {:name "body"
         :rows "3"
         :placeholder "Say something…"
         :class "textarea textarea-bordered w-full"}
        ""]
      [:div
        {:class "card-actions"}
        [:button {:type "submit" :class "btn btn-primary"} "Post"]
        [:button {:type "button" :id "fetch-post-btn" :class "btn btn-outline"} "Post via fetch"]]]
    fetch-post-script])

(def fetch-post-script
  ; Sends the same fields, but as a fetch() with the CSRF token in the X-CSRF-Token
  ; header instead of the hidden _csrf_token field — the path a JSON/SPA client would
  ; use, since it has no HTML form to embed a hidden field in.
  [:script
    {}
    (raw
      "
      document.getElementById('fetch-post-btn').addEventListener('click', async () => {
        const form = document.getElementById('message-form');
        const token = form.querySelector('input[name=_csrf_token]').value;
        const body = new URLSearchParams({
          name: form.querySelector('input[name=name]').value,
          body: form.querySelector('textarea[name=body]').value,
        });
        const res = await fetch('/messages', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-CSRF-Token': token,
          },
          body,
        });
        if (res.redirected) location.href = res.url;
      });
    ")])

(def *message-rules*
  [["name" form/required? "Name is required."]
    ; letters/digits/spaces only — required? first, so a blank name still reads "required"
    ; rather than "letters and spaces only" (validate keeps the first failing rule/field)
    ["name"
      (form/matches-pattern? "(\\w|\\s)+")
      "Name may only contain letters, digits, and spaces."]
    ["body" form/required? "Message is required."]])

(defn error-summary (errs)
  "Every error message in `errs`, space-joined — there are only ever one or two fields
  here, so a plain join reads fine without needing per-field placement in the form."
  (string/join (vals errs) " "))

(defn create (conn)
  "POST /messages — validate (web/form), insert into Postgres on success, and PRG-redirect
  either way (a validation failure flashes the error instead of touching the database)."
  (let (name (or (param conn "name") "")
        body (or (param conn "body") ""))
    (match (form/validate {"name" name "body" body} *message-rules*)
      ([:error errs] (-> conn
                       (web/session/put-flash "error" (error-summary errs))
                       (redirect-resp "/messages")))
      ([:ok _] (do
                 (db/insert-message {:name name :body body})
                 (-> conn
                   (web/session/put-flash "info" "Message posted!")
                   (redirect-resp "/messages")))))))

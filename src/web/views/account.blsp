(defmodule web/views/account
  "A plain (non-live) page demonstrating Hatch's HTTP Tier-1 plumbing: form **body params**,
  signed **sessions**, and **flash**. `GET /account` shows the display name remembered in the
  session; `POST /account` reads the submitted form field, saves it to the session, sets a
  one-shot flash, and redirects back (the POST→redirect→GET pattern). The session +flash
  plugs are wired in web/routes; `web/layout/flash-banner` renders the one-shot flash
  (shared with web/views/messages, the other flash-driven form)."
  ; page — render Hiccup to a response
  (:use web/page)
  (:use web/layout)
  ; param, redirect-resp
  (:use web/conn)
  ; get-session / put-session / put-flash
  (:alias web/session)
  ; csrf-input — the hidden token field the POST is checked against
  (:alias web/csrf)
  ; validate / error-for / max-length? — save's plain-HTTP validation demo
  (:alias web/form))
(defn index (conn)
  "GET /account — show the session-remembered name and a form to change it."
  (page conn
    (layout "Account"
      [:h1 {:class "text-2xl font-bold mb-2"} "Account · session + flash"]
      [:p
        {:class "mb-4 opacity-70"}
        "Your name is kept in a signed session cookie. Saving it sets a one-shot flash and "
        "redirects — the message shows once, then is gone on the next load."]
      (flash-banner conn)
      (greeting conn)
      [:form
        {:method "post" :action "/account" :class "card bg-base-200"}
        [:div
          {:class "card-body space-y-3"}
          (csrf/csrf-input conn)
          [:label {:class "label"} [:span {:class "label-text"} "Display name"]]
          [:input
            {:name "name"
             :value (session/get-session conn "name" "")
             :placeholder "Ada"
             :class "input input-bordered w-full"}]
          [:div
            {:class "card-actions"}
            [:button {:class "btn btn-primary"} "Save"]]]])))

(defn greeting (conn)
  "A welcome line when the session already remembers a name, else a prompt."
  (let (name (session/get-session conn "name"))
    (if (or (nil? name) (= name ""))
      [:p {:class "mb-4"} "We don't know your name yet — set it below."]
      [:p {:class "mb-4 text-lg"} (str "Welcome back, " name "!")])))

(def *name-rules*
  ; blank stays a valid, intentional "clear my name" — only bound the *length* of a
  ; non-empty name, so that feature keeps working
  [["name" (form/max-length? 50) "must be 50 characters or fewer"]])

(defn save (conn)
  "POST /account — validate the form's `name` body param (web/form), persist it to the
  session and flash a confirmation on success, or flash the validation error and leave
  the session untouched on failure — either way, redirect back to GET /account (PRG)."
  (let (name (or (param conn "name") ""))
    (match (form/validate {"name" name} *name-rules*)
      ([:error errs] (-> conn
                       (session/put-flash "error" (form/error-for errs "name"))
                       (redirect-resp "/account")))
      ([:ok _] (-> conn
                 (session/put-session "name" name)
                 (session/put-flash "info"
                   (if (= name "") "Cleared your name." (str "Saved! Hi, " name ".")))
                 (redirect-resp "/account"))))))

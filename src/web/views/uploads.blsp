(defmodule web/views/uploads
  "A plain (non-live) page demonstrating hatch's newest HTTP-side pair — multipart file
  uploads (`web/conn/files`/`file`, plus the spooled-to-disk path for large bodies:
  `web/conn/spooled?`/`parse-upload-file`) and binary asset serving — stored in Postgres
  rather than the filesystem (a `bytea` column; see `db/uploads-schema`'s docstring for
  why the file bytes are hex-literal-encoded by hand rather than bound as a raw `bytes`
  param). `GET /uploads` lists every upload with a delete button; `GET /uploads/:id/file`
  serves one back byte-faithfully, straight out of the database; `POST /uploads/:id/delete`
  removes it.

  Whichever of the two upload paths actually runs depends on nothing this view controls:
  `web/endpoint`'s `:spool-threshold` decides, per request, whether the body arrived in
  memory (`file`) or was streamed straight to a temp file on disk (`spooled?` +
  `parse-upload-file` — see that function's docstring for why a spooled *multipart*
  request needs it instead of the zero-copy `save-body`: the spooled file is the whole
  multipart envelope, not just the isolated file bytes).

  The upload form submits via `fetch`, not a plain HTML POST, carrying the CSRF token as
  an `X-CSRF-Token` header rather than the usual hidden field — not a style choice, a
  requirement discovered by testing this view against a real spooled request: a spooled
  body is streamed straight to disk unparsed, so `:body-params` (and with it, a hidden
  `_csrf_token` field) is empty for a spooled multipart request. The header path is
  read regardless (`web/csrf/submitted-token` checks it as a fallback), since HTTP
  headers are always parsed before the server ever decides whether to spool the body."
  (:use web/page)
  (:use web/layout)
  (:use web/conn)
  ; raw — the upload-form-script's inline <script> body, unescaped
  (:use web/template)
  (:alias web/session)
  (:alias web/csrf)
  (:alias encoding)
  (:alias db))

(defn index (conn)
  "GET /uploads — every upload (with a delete button) + an upload form."
  (page conn
    (layout "Uploads"
      [:h1 {:class "text-2xl font-bold mb-2"} "File uploads · Postgres-backed"]
      [:p
        {:class "mb-4 opacity-70"}
        "multipart/form-data, parsed byte-faithfully whether the body stayed in memory "
        "or (past a size threshold) streamed straight to disk — stored as a "
        [:code {:class "badge badge-ghost"} "bytea"]
        " column and served back byte-for-byte, straight out of Postgres."]
      (flash-banner conn)
      (upload-list conn (db/all-uploads))
      [:form
        {:id "upload-form" :data-csrf (csrf/token conn) :class "card bg-base-200"}
        [:div
          {:class "card-body space-y-3"}
          [:input
            {:type "file"
             :id "upload-input"
             :name "upload"
             :class "file-input file-input-bordered w-full"}]
          [:div
            {:class "card-actions"}
            [:button {:type "button" :id "upload-btn" :class "btn btn-primary"} "Upload"]]]]
      upload-form-script)))

(defn upload-list (conn uploads)
  "The list of uploaded files (metadata only — no bytes, see db/all-uploads), each with
  a link to /uploads/:id/file and its own delete form."
  (if (empty? uploads)
    [:p {:class "opacity-60 mb-4"} "No uploads yet — be the first!"]
    [:div
      {:class "space-y-2 mb-6"}
      (map uploads (fn (u) (upload-row conn u)))]))

(defn upload-row (conn u)
  [:div
    {:class "card bg-base-200"}
    [:div
      {:class "card-body py-3 flex-row items-center justify-between"}
      [:div
        {}
        [:a
          {:href (str "/uploads/" (get u :id) "/file") :class "link font-semibold"}
          (get u :filename)]
        [:span
          {:class "text-sm opacity-60 ml-2"}
          (str (get u :content_type) " · " (get u :size) " bytes")]]
      [:form
        {:method "post" :action (str "/uploads/" (get u :id) "/delete")}
        (csrf/csrf-input conn)
        [:button {:class "btn btn-xs btn-error"} "Delete"]]]])

(def upload-form-script
  ; A plain form POST can't set a custom header, and the hidden-field CSRF token isn't
  ; readable server-side for a spooled request (see this module's docstring) — so this
  ; submits via fetch with the token as X-CSRF-Token, which works either way.
  [:script
    {}
    (raw
      "
      document.getElementById('upload-btn').addEventListener('click', async () => {
        const form = document.getElementById('upload-form');
        const fileInput = document.getElementById('upload-input');
        if (!fileInput.files[0]) return;
        const fd = new FormData();
        fd.append('upload', fileInput.files[0]);
        const res = await fetch('/uploads', {
          method: 'POST',
          headers: { 'X-CSRF-Token': form.dataset.csrf },
          body: fd,
        });
        if (res.redirected) location.href = res.url;
      });
    ")])

(defn bytea-literal (bytes)
  "A Postgres bytea text-format literal (`\\x` + hex) for a raw `bytes` value — see
  db/uploads-schema's docstring for why this is built by hand rather than bound as a
  `bytes` param directly.

  (hatch-demo/web/views/uploads/bytea-literal (string/->bytes \"AB\")) ;=> \"\\\\x4142\""
  (str "\\x" (encoding/hex-encode-bytes bytes)))

(defn create (conn)
  "POST /uploads — store the uploaded file's bytes in Postgres and flash a confirmation,
  either way redirecting to GET /uploads (PRG). Handles both upload paths: an ordinary
  in-memory `file`, or (once the body exceeds web/endpoint's :spool-threshold) the
  spooled-to-disk path, which needs `parse-upload-file` to pull the file part back out of
  the spooled multipart envelope (see this module's docstring)."
  (let (f (if (spooled? conn)
            (get-in (or (parse-upload-file conn) {}) [:files "upload"])
            (file conn "upload")))
    (if (nil? f)
      (-> conn
        (session/put-flash "error" "Pick a file first.")
        (redirect-resp "/uploads"))
      (let (data (get f :bytes))
        (db/insert-upload {:filename (or (get f :filename) "upload")
                           :content_type (or (get f :content-type) "application/octet-stream")
                           :size (count data)
                           :data (bytea-literal data)})
        (-> conn
          (session/put-flash "info" "Uploaded!")
          (redirect-resp "/uploads"))))))

(defn safe-attachment-filename (filename)
  "A filename safe to place inside a `Content-Disposition` quoted-string: `\"` and `\\`
  stripped (CR/LF are already dropped by the response serializer's `header-safe`), with a
  plain fallback for a blank name.

  (hatch-demo/web/views/uploads/safe-attachment-filename \"a\\\"b.png\") ;=> \"ab.png\"
  (hatch-demo/web/views/uploads/safe-attachment-filename \"\") ;=> \"upload\""
  (let (cleaned (string/replace (string/replace (or filename "") "\"" "") "\\" ""))
    (if (= (string/trim cleaned) "") "upload" cleaned)))

(defn show-file (conn)
  "GET /uploads/:id/file — the stored file's bytes, byte-faithfully, straight out of
  Postgres (no filesystem involved at all).

  The stored `content_type` is attacker-controlled (it is whatever the upload's multipart
  part declared), so serving the bytes back inline would let an uploaded `text/html` (or
  SVG) file execute script on this origin — stored XSS. Two defenses close that: a
  `Content-Disposition: attachment` forces a download rather than an inline render, and
  `X-Content-Type-Options: nosniff` stops the browser from second-guessing the declared
  type. The bytes themselves are still served exactly as stored."
  (let (id (string/->number (or (param conn "id") "0"))
        u (db/get-upload id))
    (if (nil? u)
      (not-found-resp conn)
      (-> conn
        (put-resp-header :content-type (get u :content_type))
        (put-resp-header :x-content-type-options "nosniff")
        (put-resp-header :content-disposition
          (str "attachment; filename=\"" (safe-attachment-filename (get u :filename)) "\""))
        (send-resp 200 (get u :data))))))

(defn destroy (conn)
  "POST /uploads/:id/delete — remove the row and redirect back to GET /uploads (PRG)."
  (let (id (string/->number (or (param conn "id") "0")))
    (db/delete-upload id)
    (-> conn
      (session/put-flash "info" "Deleted.")
      (redirect-resp "/uploads"))))

(defn csrf-token (conn)
  "GET /csrf-token — the current session's CSRF token as JSON.

  A CSRF-token bootstrap for clients that cannot be handed one in their HTML: the live
  upload-progress view (`web/views/upload-progress`) has no Conn in `render`, so unlike
  every other form here it cannot call `csrf/csrf-input`. This route sits inside the
  router's CSRF `through` pipeline, so `csrf/token` mints-or-reads the token bound to the
  signed session cookie — the same token the POST is then checked against. Handing it out
  to the session it already belongs to grants nothing: an attacker's cross-site page
  cannot read this response (no CORS grant), which is exactly the property synchronizer-
  token CSRF relies on."
  (json-resp conn (str "{\"token\":\"" (csrf/token conn) "\"}")))

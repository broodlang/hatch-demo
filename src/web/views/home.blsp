; layout owns the shell (<main>, width, nav bar)
(defmodule web/views/home
  "The home page — a plain (non-live) page. The router maps GET / to the `index`
  action."
  ; page — render a Hiccup document to a response
  (:use web/page)
  ; put-resp-header / send-resp — the favicon response is built by hand (no Hiccup)
  (:use web/conn)
  ; public-for — the icon never changes, so it should not be re-asked for on every visit
  (:alias web/cache)
  (:use web/layout))
(defn index (conn)
  "GET / — the landing page: four examples across the page/live × inline/template matrix."
  (page conn
    (layout "hatch"
      [:h1 {:class "text-3xl font-bold mb-2"} "Hatch — markup, four ways"]
      [:p
        {:class "mb-6 opacity-70"}
        "The same render format (Hiccup) reached two ways — written inline, or "
        "compiled from an HTML-flavoured "
        [:code {:class "badge badge-ghost"} ".bml"]
        " template — across plain pages and live views."]
      [:div
        {:class "grid gap-4 sm:grid-cols-2"}
        [:div
          {:class "card bg-base-200"}
          [:div
            {:class "card-body"}
            [:h2
              {:class "card-title"}
              "Plain pages "
              [:span {:class "badge badge-ghost"} "web/page"]]
            [:ul
              {:class "menu p-0"}
              [:li {} [:a {:href "/page-inline"} "1a · inline Hiccup"]]
              [:li {} [:a {:href "/page-template"} "1b · template (page-template.bml)"]]]]]
        [:div
          {:class "card bg-base-200"}
          [:div
            {:class "card-body"}
            [:h2
              {:class "card-title"}
              "Live views "
              [:span {:class "badge badge-ghost"} "web/live"]]
            [:ul
              {:class "menu p-0"}
              [:li {} [:a {:href "/counter-inline"} "2a · inline render"]]
              [:li {} [:a {:href "/counter"} "2b · template (counter.bml)"]]]]]]
      [:p
        {:class "mt-6 text-sm opacity-60"}
        "2a and 2b render identical UI — inline Hiccup vs the .bml that lowers to it."])))

;; The icon the layout also carries inline, served for the clients that ask for
;; /favicon.ico without reading the markup. `web/cache/public-for` because it never changes
;; and there is no reason for a browser to re-ask on every visit.
(defn favicon (conn)
  "GET /favicon.ico — the site icon as an SVG, cached for a day."
  (-> conn
    (put-resp-header :content-type "image/svg+xml")
    (put-resp-header :cache-control (cache/public-for 86400))
    (send-resp 200 *favicon-svg*)))

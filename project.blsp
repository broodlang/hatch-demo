;; hatch-demo — a demo app built on the Hatch web framework.
;;
;; Depends on Hatch via a :git dep tracking the broodlang org. To develop both
;; side by side (live edits, no re-fetch), swap to a local :path dep:
;;
;;   :dependencies [[hatch :path "../hatch"]]
(project
  :name "hatch-demo"
  :version "0.1.0"
  :dependencies [[hatch :git "https://github.com/broodlang/hatch.git" :ref "main"]
                 [store-postgres :git "https://github.com/broodlang/store-postgres.git" :ref "main"]]
  ;; Pull in Hatch's formatter rules (its :format-headers) so `nest format` indents
  ;; deflive / on / tick / mount / render with the signature on the head line.
  :format-plugins [hatch])

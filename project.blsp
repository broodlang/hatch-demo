;; hatch-demo — a demo app built on the Hatch web framework.
;;
;; Depends on Hatch from the hosted package registry (hive), tracking a compatible
;; caret range. To develop both side by side (live edits, no re-fetch), swap to a
;; local :path dep:
;;
;;   :dependencies [[hatch :path "../hatch"]]
(project
  :name "hatch-demo"
  :version "0.2.0"
  :brood ">= 0.23.0"
  :dependencies
    [[hatch :version "^0.8.0"]
      [store-postgres :version "^0.4.0"]]
  ;; Pull in Hatch's formatter rules (its :format-headers) so `nest format` indents
  ;; deflive / on / tick / mount / render with the signature on the head line.
  :format-plugins [hatch])

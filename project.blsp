;; hatch-demo — a demo app built on the Hatch web framework.
;;
;; Depends on a PUBLISHED Hatch, deliberately: this demo is also the proof that hatch
;; installs and loads as a real package from the registry, the way anyone else gets it.
;; A :git pin here buys nothing the registry does not and retires that test, so keep the
;; version range.
;;
;; To develop both side by side (live edits, no re-fetch), swap to a local :path dep:
;;
;;   [hatch :path "../hatch"]
;;
;; and re-run `nest fetch`. Put the version range back before committing.
(project
  :name "hatch-demo"
  :version "0.3.4"
  :brood ">= 0.23.0"
  :dependencies
    [[hatch :version "^0.21.3"]
      [store-postgres :version "^0.6.0"]]
  ;; Pull in Hatch's formatter rules (its :format-headers) so `nest format` indents
  ;; deflive / on / tick / mount / render with the signature on the head line.
  :format-plugins [hatch])
